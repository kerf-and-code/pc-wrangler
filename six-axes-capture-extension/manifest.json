{
  "manifest_version": 3,
  "name": "Six Axes Capture",
  "version": "2.4.2",
  "description": "Sends your D&D Beyond rolls (with Beyond20) and, when you turn it on, the rolls in your Roll20 game's chat to your Six Axes table.",
  "icons": {
    "16": "icon-16.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  },
  "permissions": [
    "storage",
    "scripting"
  ],
  "optional_host_permissions": [
    "https://app.roll20.net/*"
  ],
  "host_permissions": [
    "https://*.dndbeyond.com/*",
    "https://www.six-axes.com/*",
    "https://six-axes.com/*",
    "https://pc-wrangler.vercel.app/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.dndbeyond.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.six-axes.com/x/*",
        "https://six-axes.com/x/*",
        "https://pc-wrangler.vercel.app/x/*"
      ],
      "js": [
        "link-capture.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "page-hook.js"
      ],
      "matches": [
        "https://*.dndbeyond.com/*"
      ]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Six Axes Capture",
    "default_icon": {
      "16": "icon-16.png",
      "48": "icon-48.png",
      "128": "icon-128.png"
    }
  }
}